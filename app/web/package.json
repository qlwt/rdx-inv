  "type": "module",
  "scripts": {
    "serve:dev": "node ./build/server/entry/index_dev.js",
    "serve:prod": "node ./build/server/entry/index_prod.js",
    "build": "run-p build:client build:server",
    "build:client": "run-s build:client:clean build:client:bundle",
